{
  "name": "naeki-pb-app",
  "productName": "Naeki Sushi Showcase · Neon",
  "version": "2.12.0-neon",
  "description": "Naeki showcase backed by Neon Postgres via a thin local API (real auth + seeded menu/branches)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "api": "node server/api.mjs",
    "check": "node scripts/validate.mjs",
    "check:mobile": "electron scripts/audit-mobile.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --project=electron",
    "test:e2e:web": "playwright test --project=web",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
