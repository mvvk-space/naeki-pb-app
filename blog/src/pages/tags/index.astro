---
import Base from "@/layouts/Base.astro";
import { Badge } from "@/components/ui/badge";
import { getCollection } from "astro:content";
import { tagCounts, tagHref, publishedPosts } from "@/lib/blog";

const posts = publishedPosts(await getCollection("blog"));
const tags = tagCounts(posts);
---

<Base title="Tags — Naeki Journal">
  <h1 class="text-3xl font-semibold">Tags</h1>
  <p class="mt-3 text-muted-foreground">
    {tags.length} {tags.length === 1 ? "tag" : "tags"} across {posts.length}
    {posts.length === 1 ? "post" : "posts"}.
  </p>

  <ul class="mt-10 flex flex-wrap gap-3">
    {tags.map(({ tag, count }) => (
      <li>
        <a href={tagHref(tag)} class="group inline-flex items-center gap-2 no-underline">
          <Badge variant="gold" className="transition-colors group-hover:border-gold/60">
            {tag}
            <span class="text-[0.65rem] text-gold/80">{count}</span>
          </Badge>
        </a>
      </li>
    ))}
  </ul>

  <a href="/blog" class="mt-12 inline-block text-sm text-muted-foreground transition-colors hover:text-foreground">
    ← All posts
  </a>
</Base>
